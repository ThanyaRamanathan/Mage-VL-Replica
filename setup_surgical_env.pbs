#!/bin/sh
#PBS -N surgical_env
#PBS -l select=1:ngpus=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o surgical_env.$PBS_JOBID.txt
#PBS -q normal

set -eu
cd "$PBS_O_WORKDIR"

module load cuda
module load miniforge3
module load gcc/11.2.0

ENV_NAME="${ENV_NAME:-surgical}"
PYTHON_VERSION="${PYTHON_VERSION:-3.11}"
TORCH_VERSION="${TORCH_VERSION:-2.11.0}"
TORCHVISION_VERSION="${TORCHVISION_VERSION:-0.26.0}"
PYTORCH_INDEX_URL="${PYTORCH_INDEX_URL:-https://download.pytorch.org/whl/cu128}"

if ! conda env list | awk '{print $1}' | grep -Fxq "$ENV_NAME"; then
    conda create -y -n "$ENV_NAME" "python=$PYTHON_VERSION"
fi

conda run -n "$ENV_NAME" python -m pip install --upgrade pip
conda run -n "$ENV_NAME" python -m pip install --upgrade --force-reinstall \
    "torch==$TORCH_VERSION" "torchvision==$TORCHVISION_VERSION" \
    --index-url "$PYTORCH_INDEX_URL"
conda run -n "$ENV_NAME" python -m pip install -e ".[dev]"
conda run -n "$ENV_NAME" python -c "import torch; assert torch.cuda.is_available(), 'CUDA unavailable'; print(torch.__version__, torch.version.cuda, torch.cuda.get_device_name(0))"
conda run -n "$ENV_NAME" python -c "import av, yaml, sklearn; print('project dependencies OK')"

echo "Environment ready: $ENV_NAME"
