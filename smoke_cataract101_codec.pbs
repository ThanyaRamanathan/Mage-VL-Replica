#!/bin/sh
#PBS -N cataract101_codec_smoke
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -q normal

set -eu
cd "$PBS_O_WORKDIR"
module load miniforge3
module load gcc/11.2.0
conda activate "${CONDA_ENV:-surgical}"
export PYTHONPATH="$PBS_O_WORKDIR/src:${PYTHONPATH:-}"

SCRATCH_ROOT="${SCRATCH_ROOT:-/scratch/users/ntu/$USER}"
VIDEOS="${VIDEOS:-$SCRATCH_ROOT/cataract101/cataract-101}"
VIDEO="${VIDEO:-}"
if [ -z "$VIDEO" ]; then
    VIDEO=$(find "$VIDEOS" -type f -name '*.mp4' ! -path '*/__MACOSX/*' ! -name '._*' | sort | head -n 1)
fi
if [ -z "$VIDEO" ] || [ ! -f "$VIDEO" ]; then
    echo "No real MP4 found below $VIDEOS" >&2
    exit 2
fi

echo "Testing native codec extraction: $VIDEO"
python -m surgical_tokens.cli inspect-codec "$VIDEO" \
    --budget 6272 --patch 16 --motion-weight 0.5 --limit 384 \
    --sample-step 12 --anchor-fraction 0.5
